{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "backend/Cargo.toml"
        ]
      }
    }
  },
  "languages": {
    "Dart": {
      "format_on_save": "on"
    },
    "Rust": {
      "format_on_save": "on"
    }
  },
  "file_scan_exclusions": [
    "**/.fvm",
    "**/.dart_tool",
    "**/target",
    "**/.git"
  ],
  "file_types": {
    "Dockerfile": [
      "Dockerfile.*",
      "**/Dockerfile.*",
      "*.Dockerfile"
    ]
  }
}
